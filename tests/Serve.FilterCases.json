{
  "about": "Filters of the report page in its own language (the parameters the page sends: f.<Column> a text box, m.<Column> the values of a list, x.<Column>=1 exclude them, q the search) and the rows they select, as a condition on the table of the list (UTC report time zone; one user name holds the dotted capital I, U+0130, and one Message-ID is stored in mixed case: anyCase=1 asks for every spelling of an exact Message-ID that is not stored as typed, in lower case or in upper case). Read by Serve.Backend.Tests.ps1 (the server's rows) and Serve.Page.Tests.ps1 (the same filters in the page, both modes). D0 is 2026-10-14T00:00:00Z.",
  "cases": [
    { "view": "sessions", "params": { "f.User": "user1" }, "sql": "instr(lower(c.user),'user1')>0" },
    { "view": "sessions", "params": { "f.User": "=user12" }, "sql": "lower(c.user)='user12'" },
    { "view": "sessions", "params": { "f.User": "!user1" }, "sql": "instr(lower(c.user),'user1')=0" },
    { "view": "sessions", "params": { "f.Requests": ">5" }, "sql": "c.requests>5" },
    { "view": "sessions", "params": { "f.Requests": "3..7" }, "sql": "c.requests BETWEEN 3 AND 7" },
    { "view": "sessions", "params": { "f.Requests": "!=4" }, "sql": "c.requests<>4" },
    { "view": "sessions", "params": { "f.Protocol": "=mapi" }, "sql": "lower(c.protocol)='mapi'" },
    { "view": "sessions", "params": { "m.Protocol": "Mapi|Ews" }, "sql": "c.protocol IN('Mapi','Ews')" },
    { "view": "sessions", "params": { "m.Protocol": "Mapi|Ews", "x.Protocol": "1" }, "sql": "c.protocol NOT IN('Mapi','Ews')" },
    { "view": "sessions", "params": { "f.Front ends": "=ex2" }, "sql": "instr(','||lower(c.front_ends)||',',',ex2,')>0" },
    { "view": "sessions", "params": { "f.Start": "<2026-10-14 06:00" }, "sql": "c.start_ms<1791936000000+21600000" },
    { "view": "sessions", "params": { "f.Start": "10:00..10:15" }, "sql": "(c.start_ms%86400000)>=36000000 AND (c.start_ms%86400000)<36960000" },
    { "view": "sessions", "params": { "q": "protocol:owa -user:user2" }, "sql": "instr(lower(c.protocol),'owa')>0 AND instr(lower(c.user),'user2')=0" },
    { "view": "sessions", "params": { "q": "user7" }, "sql": "instr(lower(c.user),'user7')>0" },
    { "view": "sessions", "params": { "m.User": "user3|USER3" }, "sql": "c.user IN('user3','USER3')" },
    { "view": "sessions", "params": { "f.User": "istanbul" }, "sql": "c.user=char(304)||'STANBUL'" },
    { "view": "sessions", "params": { "q": "user:\u0130stanbul" }, "sql": "c.user=char(304)||'STANBUL'" },
    { "view": "sessions", "params": { "m.Authentication": "Basic" }, "sql": "instr(';'||COALESCE(c.auth_modes,''),';Basic=')>0" },
    { "view": "sessions", "params": { "m.Authentication": "Forms" }, "sql": "instr(';'||COALESCE(c.auth_modes,''),';FBA=')>0" },
    { "view": "sessions", "params": { "f.Authentication": "=OAuth" }, "sql": "instr(';'||COALESCE(c.auth_modes,''),';OAuth=')>0" },
    { "view": "sessions", "params": { "f.Authentication": "!OAuth" }, "sql": "instr(';'||COALESCE(c.auth_modes,''),';OAuth=')=0" },
    { "view": "sessions", "params": { "q": "authentication:oauth" }, "sql": "instr(';'||COALESCE(c.auth_modes,''),';OAuth=')>0" },
    { "view": "messages", "params": { "f.Sender": "alpha1" }, "sql": "instr(lower(r.sender),'alpha1')>0" },
    { "view": "messages", "params": { "m.Status": "Partially failed" }, "sql": "(SELECT text FROM message_rollup_value v WHERE v.id=r.status)='Partially failed'" },
    { "view": "messages", "params": { "f.Status": "!transit" }, "sql": "instr(lower((SELECT text FROM message_rollup_value v WHERE v.id=r.status)),'transit')=0" },
    { "view": "messages", "params": { "f.Failed": ">=1" }, "sql": "r.failed>=1" },
    { "view": "messages", "params": { "f.Message ID": "=<m5@invalid>" }, "sql": "r.kind=0 AND r.identity='<m5@invalid>'" },
    { "view": "messages", "params": { "f.Message ID": "=<M5@INVALID>" }, "sql": "r.kind=0 AND r.identity='<m5@invalid>'" },
    { "view": "messages", "params": { "f.Message ID": "=<m7@invalid>", "anyCase": "1" }, "sql": "r.kind=0 AND r.identity='<M7@Invalid>'" },
    { "view": "messages", "params": { "q": "subject:\"subject 7\"" }, "sql": "instr(lower(r.subject),'subject 7')>0" },
    { "view": "issues", "params": { "f.Protocol": "owa" }, "sql": "instr(lower(e.protocol),'owa')>0" },
    { "view": "issues", "params": { "f.Status": "500" }, "sql": "e.status=500" },
    { "view": "issues", "params": { "f.URL": "!ews" }, "sql": "instr(lower(e.url),'ews')=0" },
    { "view": "issues", "params": { "m.Outcome": "Slow" }, "sql": "e.outcome='Slow'" }
  ]
}
