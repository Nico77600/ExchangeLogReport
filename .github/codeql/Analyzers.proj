<Project DefaultTargets="Build">
  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.Csc"
             AssemblyFile="$(MSBuildToolsPath)\Roslyn\Microsoft.Build.Tasks.CodeAnalysis.dll" />
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepositoryRoot)\$(ProductionSourceRoot)\**\*.cs" />
    <Reference Include="$(PowerShellHome)\ref\*.dll" />
    <Reference Include="$(RepositoryRoot)\package\lib\sqlite\*.dll" Condition="'$(RequiresSqlite)' == 'true'" />
    <SecurityAnalyzer Include="$(AnalyzerRoot)\analyzers\dotnet\cs\Microsoft.CodeAnalysis.NetAnalyzers.dll" />
    <SecurityAnalyzer Include="$(AnalyzerRoot)\analyzers\dotnet\cs\Microsoft.CodeAnalysis.CSharp.NetAnalyzers.dll" />
    <SecurityAnalyzerConfig Include="$(MSBuildThisFileDirectory)security-analyzers.globalconfig" />
  </ItemGroup>
  <Target Name="Build">
    <Error Condition="'$(ProductionSourceRoot)' == '' or '$(OutputDirectory)' == '' or '$(PowerShellHome)' == '' or '$(AnalyzerRoot)' == ''"
           Text="ProductionSourceRoot, OutputDirectory, PowerShellHome and AnalyzerRoot are required." />
    <Error Condition="'@(Compile)' == ''" Text="No production C# sources were selected." />
    <Error Condition="'@(Reference)' == ''" Text="PowerShell reference assemblies are unavailable." />
    <MakeDir Directories="$(OutputDirectory)" />
    <Csc Sources="@(Compile)" References="@(Reference)"
         Analyzers="@(SecurityAnalyzer)" AnalyzerConfigFiles="@(SecurityAnalyzerConfig)"
         ErrorLog="$(OutputDirectory)\netanalyzers.sarif,version=2"
         OutputAssembly="$(OutputDirectory)\Analyzers.Analysis.dll"
         TargetType="Library" NoStandardLib="true" NoConfig="true" TreatWarningsAsErrors="false"
         UseSharedCompilation="false" Deterministic="true" Optimize="false" />
  </Target>
</Project>
