<?xml version="1.0" encoding="utf-8"?>
<!-- Declaration only. Lists the NuGet packages whose binaries are committed in package\lib\sqlite, so that the GitHub dependency graph
     can match them with security advisories. It is not restored or built, and it is not part of the package.
     The versions, official URLs and SHA-256 pins are in product.json (sqliteLibraries) and are verified by tools\Test-SqliteLibraries.ps1. -->
<packages>
  <package id="Microsoft.Data.Sqlite.Core" version="10.0.12" targetFramework="net8.0" />
  <package id="SQLitePCLRaw.core" version="2.1.14" targetFramework="netstandard2.0" />
  <package id="SQLitePCLRaw.provider.e_sqlite3" version="2.1.14" targetFramework="netstandard2.0" />
  <package id="SQLitePCLRaw.bundle_e_sqlite3" version="2.1.14" targetFramework="netstandard2.0" />
  <package id="SQLitePCLRaw.lib.e_sqlite3" version="2.1.14" targetFramework="netstandard2.0" />
</packages>
